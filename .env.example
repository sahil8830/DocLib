# ============================================================
#  CONTEXA — Environment Variables
#  Copy this file to .env and fill in your values
# ============================================================

# Google Gemini API Key (get free key from https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# JWT Secret (any long random string)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# MongoDB Connection URI
# Local MongoDB:  mongodb://localhost:27017/doclib
# MongoDB Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/doclib
MONGODB_URI=mongodb://localhost:27017/doclib

# Node.js Backend
PORT=3001
NODE_ENV=development

# Python AI Microservice URL (runs locally)
AI_SERVICE_URL=http://localhost:8000

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
